# FRIDAY Configuration File (.env)
# Copy this file to .env and populate with your settings

# Application Environment (development, production, testing)
FRIDAY_ENV=development

# Logging Settings
FRIDAY_LOG_LEVEL=INFO
FRIDAY_LOG_FILE=logs/friday.log

# LLM Provider Configuration
# Supported providers: chain (RECOMMENDED), gemini, groq, cerebras, openrouter, openai, mock, ollama
# 'chain' = cross-provider automatic failover for text/reasoning:
#   Groq (llama-3.3-70b-versatile -> llama-3.1-8b-instant on 429) -> Cerebras -> OpenRouter
# Gemini remains exclusively for Voice (Gemini Live), Vision, and Embeddings regardless of this setting.
FRIDAY_LLM_PROVIDER=chain

# Model Name (used by 'gemini'/'openai' providers; per-provider overrides below)
FRIDAY_LLM_MODEL=gemini-1.5-flash-latest

# Cost Mode & Limits
# 'free_first' ensures predictable free-tier utilization and prevents unexpected paid billing
FRIDAY_COST_MODE=free_first
# Optional safety limit on total daily LLM requests:
# FRIDAY_MAX_DAILY_REQUESTS=1000

# Google Gemini API Key & Tuning (Voice/Vision/Embeddings + 'gemini' text provider)
# WARNING: NEVER commit actual API keys to version control!
FRIDAY_GEMINI_API_KEY=
FRIDAY_GEMINI_TIMEOUT=60.0
FRIDAY_GEMINI_MAX_RETRIES=3
FRIDAY_GEMINI_BACKOFF_FACTOR=2.0
# Optional Gemini-specific overrides:
# FRIDAY_GEMINI_MODEL=gemini-1.5-flash-latest
# FRIDAY_GEMINI_MAX_TOKENS=2048
# FRIDAY_GEMINI_TEMPERATURE=0.7

# Text/Reasoning Fallback Chain Providers ('chain', 'groq', 'cerebras', 'openrouter')
# Groq (first in chain): defaults to llama-3.3-70b-versatile with automatic
# 429 fallback to llama-3.1-8b-instant
FRIDAY_GROQ_API_KEY=
# FRIDAY_GROQ_MODEL=llama-3.3-70b-versatile
# FRIDAY_GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Cerebras (second in chain): defaults to llama3.1-8b-8192
FRIDAY_CEREBRAS_API_KEY=
# FRIDAY_CEREBRAS_MODEL=llama3.1-8b-8192
# OpenRouter (last in chain): defaults to meta-llama/llama-3.3-70b-instruct
FRIDAY_OPENROUTER_API_KEY=
# FRIDAY_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI API Keys & Endpoints (When using 'openai' provider)
FRIDAY_LLM_API_KEY=
FRIDAY_LLM_BASE_URL=https://api.openai.com/v1

# Temperature & Max Tokens
FRIDAY_LLM_TEMPERATURE=0.7
FRIDAY_LLM_MAX_TOKENS=2048

# Memory Configuration
FRIDAY_MEMORY_BACKEND=sqlite
FRIDAY_MEMORY_DB_PATH=data/friday.db
FRIDAY_MEMORY_MAX_MESSAGES=50
# Optional retention policy in days (None/0 for indefinite):
# FRIDAY_MEMORY_RETENTION_DAYS=30

# Semantic Long-Term Memory (Cloud-First Embeddings)
# Supported embedding providers: gemini, mock, none
FRIDAY_EMBEDDING_PROVIDER=gemini
FRIDAY_EMBEDDING_MODEL=gemini-embedding-2
FRIDAY_EMBEDDING_DIMENSION=768
FRIDAY_EMBEDDING_SIMILARITY_THRESHOLD=0.6

# Voice Interface Settings
FRIDAY_VOICE_ENABLED=false
FRIDAY_VOICE_PROVIDER=gemini

# Agent Identity
FRIDAY_AGENT_NAME=FRIDAY
FRIDAY_USER_NAME=Surendra
