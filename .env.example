# FRIDAY Configuration File (.env)
# Copy this file to .env and populate with your settings

# Application Environment (development, production, testing)
FRIDAY_ENV=development

# Logging Settings
FRIDAY_LOG_LEVEL=INFO
FRIDAY_LOG_FILE=logs/friday.log

# LLM Provider Configuration
# Supported providers: mock, gemini, openai
FRIDAY_LLM_PROVIDER=gemini

# Model Name (e.g. gemini-2.5-flash, gemini-1.5-pro, gpt-4o-mini)
FRIDAY_LLM_MODEL=gemini-2.5-flash

# Cost Mode & Limits
# 'free_first' ensures predictable free-tier utilization and prevents unexpected paid billing
FRIDAY_COST_MODE=free_first
# Optional safety limit on total daily LLM requests:
# FRIDAY_MAX_DAILY_REQUESTS=1000

# Google Gemini API Key & Tuning (When using 'gemini' provider)
# WARNING: NEVER commit actual API keys to version control!
FRIDAY_GEMINI_API_KEY=
FRIDAY_GEMINI_TIMEOUT=60.0
FRIDAY_GEMINI_MAX_RETRIES=3
FRIDAY_GEMINI_BACKOFF_FACTOR=2.0
# Optional Gemini-specific overrides:
# FRIDAY_GEMINI_MODEL=gemini-2.5-flash
# FRIDAY_GEMINI_MAX_TOKENS=2048
# FRIDAY_GEMINI_TEMPERATURE=0.7

# OpenAI API Keys & Endpoints (When using 'openai' provider)
FRIDAY_LLM_API_KEY=
FRIDAY_LLM_BASE_URL=https://api.openai.com/v1

# Temperature & Max Tokens
FRIDAY_LLM_TEMPERATURE=0.7
FRIDAY_LLM_MAX_TOKENS=2048

# Memory Configuration
FRIDAY_MEMORY_MAX_MESSAGES=50

# Agent Identity
FRIDAY_AGENT_NAME=FRIDAY
FRIDAY_USER_NAME=Boss
