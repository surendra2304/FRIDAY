# FRIDAY Configuration File (.env)
# Copy this file to .env and populate with your settings

# Application Environment (development, production, testing)
FRIDAY_ENV=development

# Logging Settings
FRIDAY_LOG_LEVEL=INFO
FRIDAY_LOG_FILE=logs/friday.log

# LLM Provider Configuration
# Supported providers: mock, openai
FRIDAY_LLM_PROVIDER=mock

# Model Name
FRIDAY_LLM_MODEL=gpt-4o-mini

# API Keys & Endpoints (Leave empty when using 'mock' provider)
# WARNING: NEVER commit actual API keys to version control!
FRIDAY_LLM_API_KEY=
FRIDAY_LLM_BASE_URL=https://api.openai.com/v1

# Temperature & Max Tokens
FRIDAY_LLM_TEMPERATURE=0.7
FRIDAY_LLM_MAX_TOKENS=2048

# Memory Configuration
FRIDAY_MEMORY_MAX_MESSAGES=50

# Agent Identity
FRIDAY_AGENT_NAME=FRIDAY
FRIDAY_USER_NAME=Boss
