# FRIDAY Configuration File (.env)
# Copy this file to .env and populate with your settings.
# Every field below mirrors core/config.py; values shown are the safe defaults.
# Fields left empty (or omitted entirely) fall back to these defaults.
#
# WARNING: NEVER commit actual API keys to version control!
#
# ============================ TEXT/REASONING ==============================
# 'chain' (RECOMMENDED) = cross-provider automatic failover:
#   Groq -> Mistral -> OpenRouter (independent free pools)
# Gemini remains exclusively for Voice (Gemini Live), Vision, and Embeddings
# regardless of this setting.
# Supported: chain, gemini, groq, mistral, openrouter, openai, ollama, mock

# ============================ LLM & PROVIDERS ==============================
# LLM provider name: 'mock', 'openai', 'gemini'
FRIDAY_LLM_PROVIDER=chain
# Model identifier
FRIDAY_LLM_MODEL=gemini-3.6-flash
# API Key for the provider (OpenAI or general)
FRIDAY_LLM_API_KEY=
# Operating cost policy: 'free_first', 'custom'
FRIDAY_COST_MODE=free_first
# Optional safety limit on total daily LLM requests (optional; unset by default)
# FRIDAY_MAX_DAILY_REQUESTS=
# Base URL for provider API
FRIDAY_LLM_BASE_URL=https://api.openai.com/v1
# Sampling temperature
FRIDAY_LLM_TEMPERATURE=0.7
# Thinking level for Gemini Flash: low, medium, high
FRIDAY_LLM_THINKING_LEVEL=medium
# Max tokens per response
FRIDAY_LLM_MAX_TOKENS=2048
# API Key for Groq (text/reasoning only; never used for voice)
FRIDAY_GROQ_API_KEY=
# Optional Groq model override (default: openai/gpt-oss-120b) (optional; unset by default)
# FRIDAY_GROQ_MODEL=
# Groq fallback model used on 429 rate limits
FRIDAY_GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# API Key for OpenRouter (text/reasoning only; never used for voice)
FRIDAY_OPENROUTER_API_KEY=
# Optional OpenRouter model override (default: meta-llama/llama-3.3-70b-instruct) (optional; unset by default)
# FRIDAY_OPENROUTER_MODEL=
# API Key for Mistral (text/reasoning only; never used for voice)
FRIDAY_MISTRAL_API_KEY=
# Optional Mistral model override (default: mistral-large-latest) (optional; unset by default)
# FRIDAY_MISTRAL_MODEL=
# Personal Access Token for GitHub Automation (Phase 24)
FRIDAY_GITHUB_TOKEN=
# Local Smart Home / IoT Hub (Phase 27)
FRIDAY_IOT_HUB_ENABLED=false
FRIDAY_IOT_HUB_URL=http://localhost:8123
FRIDAY_IOT_HUB_TOKEN=
# Read-Only Calendar .ics URL (Phase 29)
FRIDAY_CALENDAR_ICS_URL=
# Outgoing Email SMTP Configuration (Phase 30)
FRIDAY_EMAIL_ADDRESS=
FRIDAY_EMAIL_APP_PASSWORD=
FRIDAY_EMAIL_SMTP_HOST=smtp.gmail.com
FRIDAY_EMAIL_SMTP_PORT=587
# External AI Universe Multi-Agent Debate API
AI_UNIVERSE_URL=http://localhost:8000
AI_UNIVERSE_API_KEY=
FRIDAY_UNIVERSE_API_URL=http://localhost:8000
FRIDAY_API_KEY=

# Algorithmic Trading Bot (Binance Futures Testnet on Render)
TRADING_BOT_URL=https://algorithmic-trading-bot-fra.onrender.com
TRADING_BOT_API_KEY=
BOT_API_KEY=
# Active Device Controller Platform ('windows', 'android', 'mock')
FRIDAY_ACTIVE_DEVICE=windows

# ============================ GOOGLE GEMINI (Voice / Vision / Embeddings) ==============================
# API Key specifically for Google Gemini
FRIDAY_GEMINI_API_KEY=
# Fallback Gemini API Key 1
FRIDAY_GEMINI_FALLBACK_API_KEY_1=
# Fallback Gemini API Key 2
FRIDAY_GEMINI_FALLBACK_API_KEY_2=
# Fallback Gemini API Key 3
FRIDAY_GEMINI_FALLBACK_API_KEY_3=
# Fallback Gemini API Key 4
FRIDAY_GEMINI_FALLBACK_API_KEY_4=
# Optional Gemini-specific model name override (optional; unset by default)
# FRIDAY_GEMINI_MODEL=
# Request timeout in seconds for Gemini API
FRIDAY_GEMINI_TIMEOUT=60.0
# Max retry attempts for transient Gemini API errors
FRIDAY_GEMINI_MAX_RETRIES=3
# Exponential backoff factor for retries
FRIDAY_GEMINI_BACKOFF_FACTOR=2.0
# Max output tokens override for Gemini (optional; unset by default)
# FRIDAY_GEMINI_MAX_TOKENS=
# Temperature override for Gemini (optional; unset by default)
# FRIDAY_GEMINI_TEMPERATURE=

# ============================ VOICE INTERFACE ==============================
# Enable Windows UI Automation provider (default true on Windows).
FRIDAY_UI_AUTOMATION_ENABLED=True
# Enable voice interface
FRIDAY_VOICE_ENABLED=False
# Voice provider: 'gemini' or 'mock'
FRIDAY_VOICE_PROVIDER=gemini
# Optional name or index of specific audio input device (microphone) (optional; unset by default)
# FRIDAY_AUDIO_INPUT_DEVICE=
# Optional name or index of specific audio output device (speaker) (optional; unset by default)
# FRIDAY_AUDIO_OUTPUT_DEVICE=
# Audio sample rate for microphone input (Hz)
FRIDAY_VOICE_INPUT_SAMPLE_RATE=16000
# Audio format for synthesized speech
FRIDAY_VOICE_OUTPUT_FORMAT=mp3
# Prebuilt voice name for Gemini speech synthesis (e.g. Aoede, Puck, Charon, Kore, Fenrir)
FRIDAY_VOICE_NAME=Aoede
# Playback buffer size in milliseconds for non‑blocking audio
FRIDAY_VOICE_PLAYBACK_BUFFER_MS=100
# Gemini Live multimodal voice model
FRIDAY_VOICE_LIVE_MODEL=gemini-3.1-flash-live-preview
# Audio sample rate for Gemini Live output (Hz)
FRIDAY_VOICE_LIVE_SAMPLE_RATE=24000
# Max retries for live‑stream failures
FRIDAY_VOICE_LIVE_MAX_RETRIES=3
# Initial reconnect delay in seconds
FRIDAY_VOICE_LIVE_RECONNECT_DELAY=1.0
# Enable Gemini Live session resumption
FRIDAY_VOICE_SESSION_RESUMPTION_ENABLED=True
# Enable Gemini Live context window compression
FRIDAY_VOICE_CONTEXT_COMPRESSION_ENABLED=True
# VAD start of speech sensitivity: HIGH, LOW, UNSPECIFIED (LOW prevents premature false turn starts on breath/ambient noise)
FRIDAY_VOICE_VAD_START_SENSITIVITY=LOW
# VAD end of speech sensitivity: HIGH, LOW, UNSPECIFIED
FRIDAY_VOICE_VAD_END_SENSITIVITY=HIGH
# VAD prefix audio padding (ms)
FRIDAY_VOICE_VAD_PREFIX_PADDING_MS=300
# VAD silence duration before turn complete (ms)
FRIDAY_VOICE_VAD_SILENCE_DURATION_MS=800
# Maximum continuous speaker playback timeout before auto-unmuting mic (ms)
FRIDAY_VOICE_SPEAKER_TIMEOUT_MS=10000
# RMS energy threshold for local zero-latency barge-in
FRIDAY_VOICE_BARGE_IN_RMS_THRESHOLD=350.0
# Consecutive frames exceeding threshold required to confirm user barge-in (debounce)
FRIDAY_VOICE_BARGE_IN_CONSECUTIVE_FRAMES=4
# Multiplier for barge-in threshold when FRIDAY is actively playing audio (echo protection)
FRIDAY_VOICE_BARGE_IN_PLAYBACK_FACTOR=3.0
# Cooldown window after an interruption during which new local interruptions are suppressed
FRIDAY_VOICE_BARGE_IN_COOLDOWN_SECONDS=1.0
# Whether to allow local RMS detector to interrupt during speaker playback (False lets Gemini Server VAD drive authoritative interruptions to prevent acoustic echo self-interruption)
FRIDAY_VOICE_LOCAL_BARGE_IN_DURING_PLAYBACK=False
# Whether headphones are used (enables local barge-in during playback with lower threshold)
FRIDAY_VOICE_HEADPHONES_MODE=False
# Enroll and verify the owner's voice before obeying spoken commands
# (resemblyzer; enroll with: friday --enroll-voice)
FRIDAY_VOICE_BIOMETRICS_ENABLED=False
# Exponential moving average alpha for tracking ambient noise floor
FRIDAY_VOICE_ADAPTIVE_NOISE_ALPHA=0.05
# Adaptive noise floor multiplier to declare candidate speech
FRIDAY_VOICE_ADAPTIVE_NOISE_MULTIPLIER=3.5
# Thinking level for Gemini 3.1 Live session: MINIMAL, LOW, MEDIUM, HIGH
FRIDAY_VOICE_THINKING_LEVEL=MINIMAL
# Deprecated: Thinking budget tokens for legacy models
FRIDAY_VOICE_THINKING_BUDGET=0

# ============================ VISION & MULTIMODAL ==============================
# Multimodal Gemini vision model identifier
FRIDAY_VISION_MODEL=gemini-3.6-flash
# Vision provider: 'gemini' or 'mock'
FRIDAY_VISION_PROVIDER=gemini
# Maximum allowed image size in bytes for visual analysis
FRIDAY_VISION_MAX_IMAGE_BYTES=20971520
# Screen capture provider backend: 'windows' or 'mock'
FRIDAY_SCREEN_CAPTURE_PROVIDER=windows
# Target display for capture: 'primary' or display index '0', '1', etc.
FRIDAY_SCREEN_DISPLAY=primary
# Maximum timeout in seconds for screen capture operation
FRIDAY_SCREEN_CAPTURE_TIMEOUT=5.0
# Whether background periodic screen awareness is enabled (default False)
FRIDAY_SCREEN_AWARE=False
# Minimum interval in seconds between periodic screen captures
FRIDAY_SCREEN_INTERVAL_SECONDS=10.0
# Minimum image difference ratio (0.0 to 1.0) required to trigger visual analysis for changed screens
FRIDAY_SCREEN_CHANGE_THRESHOLD=0.05
# Proactive Screen Reading (The Watcher - Phase 28)
FRIDAY_PROACTIVE_WATCHER_ENABLED=false
FRIDAY_WATCHER_INTERVAL_SECONDS=120.0
# Tesseract OCR executable path (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe on Windows)
FRIDAY_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ============================ MEMORY & SEMANTIC RECALL ==============================
# Memory backend: 'sqlite', 'in_memory'
FRIDAY_MEMORY_BACKEND=sqlite
# Path to SQLite database file
FRIDAY_MEMORY_DB_PATH=data/friday.db
# Maximum messages stored in short-term buffer
FRIDAY_MEMORY_MAX_MESSAGES=50
# Whether to persist conversations automatically
FRIDAY_MEMORY_AUTO_PERSIST=True
# Optional retention policy in days (older messages pruned) (optional; unset by default)
# FRIDAY_MEMORY_RETENTION_DAYS=
# Embedding provider: 'gemini', 'mock', 'none'
FRIDAY_EMBEDDING_PROVIDER=gemini
# Embedding model identifier
FRIDAY_EMBEDDING_MODEL=gemini-embedding-2
# Expected dimensionality of embedding vectors
FRIDAY_EMBEDDING_DIMENSION=768
# Minimum cosine similarity threshold for semantic retrieval
FRIDAY_EMBEDDING_SIMILARITY_THRESHOLD=0.6
# Memory recall mode: 'hybrid', 'semantic', 'fts', 'none'
FRIDAY_RETRIEVAL_MODE=hybrid
# Maximum historical memories to recall into context
FRIDAY_MAX_RECALLED_MEMORIES=3
# Minimum similarity threshold for recalled memories
FRIDAY_RECALL_SIMILARITY_THRESHOLD=0.6
# Maximum total characters of recalled memories injected
FRIDAY_MAX_RECALL_CHARS=1000
# Whether to automatically retrieve relevant historical context
FRIDAY_ENABLE_AUTO_RECALL=True

# ============================ TASKS & AUTONOMY ==============================
# Enable proactive task automation
FRIDAY_TASK_ENABLED=False
# Maximum allowed LLM calls per task
FRIDAY_TASK_MAX_CALLS=100
# Maximum retry attempts for transient failures
FRIDAY_TASK_RETRY_LIMIT=3
# Optional cap on total daily task executions (optional; unset by default)
# FRIDAY_TASK_DAILY_CAP=
# Consecutive failure count before disabling a task
# ============================ FORGE (AUTONOMOUS SWE ENGINE) ==============================
# Base URL for FORGE Software Engineering API
FORGE_BASE_URL=http://localhost:8000
FRIDAY_FORGE_API_URL=http://localhost:8000
# API Key for FORGE authentication and HMAC signing
FRIDAY_FORGE_API_KEY=your_forge_api_key_here
# Enable FORGE ecosystem integration
FORGE_ENABLED=True
FRIDAY_FORGE_ENABLED=true
# Maximum concurrent tasks dispatched to FORGE
FRIDAY_FORGE_MAX_CONCURRENT_TASKS=3
# Default timeout in seconds for FORGE tasks (default: 30 minutes)
FRIDAY_FORGE_TASK_TIMEOUT=1800
FRIDAY_TASK_CIRCUIT_BREAKER_THRESHOLD=3
# Polling intervals for supervision and health
FRIDAY_FORGE_SUPERVISION_INTERVAL_SECONDS=60
FRIDAY_FORGE_HEALTH_CHECK_INTERVAL_SECONDS=300

# ============================ UNIFIED ECOSYSTEM COMMAND CENTER ==============================
FRIDAY_ECOSYSTEM_ENABLED=True
FRIDAY_TRADING_BOT_BASE_URL=https://stratex-ucjz.onrender.com
STRATEX_URL=https://stratex-ucjz.onrender.com
STRATEX_API_KEY=stratex_api
FRIDAY_AI_UNIVERSE_BASE_URL=https://inference-3i2b.onrender.com
INFERENCE_URL=https://inference-3i2b.onrender.com
INFERENCE_API_KEY=inference_api
FRIDAY_MEMORA_BASE_URL=https://memora-9zr9.onrender.com
MEMORA_URL=https://memora-9zr9.onrender.com
MEMORA_API_KEY=memora_api
FRIDAY_INTELX_BASE_URL=https://intelx-3cz1.onrender.com
INTELX_URL=https://intelx-3cz1.onrender.com
INTELX_API_KEY=intelx_api
FRIDAY_FUTURIS_BASE_URL=https://futuris-x4f4.onrender.com
FUTURIS_URL=https://futuris-x4f4.onrender.com
FUTURIS_API_KEY=futuris_api
FRIDAY_NEXUS_BASE_URL=https://cortex-qifr.onrender.com
CORTEX_URL=https://cortex-qifr.onrender.com
CORTEX_API_KEY=cortex_api
FRIDAY_NEXUS_ENABLED=True
FRIDAY_NEXUS_VIGILANCE_INTERVAL_SECONDS=60
FRIDAY_FORGE_BASE_URL=http://localhost:8000
FRIDAY_SENTINEL_BASE_URL=http://localhost:8003

# ============================ GENERAL / IDENTITY / LOGGING ==============================
# Environment (development, production, testing)
FRIDAY_ENV=development
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FRIDAY_LOG_LEVEL=INFO
# Path to log file
FRIDAY_LOG_FILE=logs/friday.log
# Name of the AI assistant
FRIDAY_AGENT_NAME=FRIDAY
# Name/title to address the user
FRIDAY_USER_NAME=Surendra
# Directory for SQLite hot backups
FRIDAY_BACKUP_DIR=data/backups

# ============================ NOTES =======================================
# - Missing or empty variables ALWAYS fall back to the safe defaults above.
# - Voice mode starts with 'friday --voice' (CLI override) or
#   FRIDAY_VOICE_ENABLED=true below.
# - Headphones: set FRIDAY_VOICE_HEADPHONES_MODE=true to disable echo
#   suppression and enable full-duplex barge-in (interrupt FRIDAY mid-sentence).
