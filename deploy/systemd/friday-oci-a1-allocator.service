[Unit]
Description=FRIDAY Universe persistent Oracle Ampere A1 allocator
Documentation=https://github.com/surendra2304/FRIDAY
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=friday-allocator
Group=friday-allocator
WorkingDirectory=/opt/friday-oci-a1-allocator
EnvironmentFile=-/etc/friday-oci-a1-allocator.conf
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=INFO
Environment=OCI_A1_STATE_PATH=/var/lib/friday-oci-a1-allocator/state.json
ExecStart=/opt/friday-oci-a1-allocator/.venv/bin/python /opt/friday-oci-a1-allocator/oci_a1_continuous_allocator.py
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=30
StartLimitIntervalSec=0
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/friday-oci-a1-allocator
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
